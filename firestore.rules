rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(userId) { return signedIn() && request.auth.uid == userId; }
    function owner(data) { return signedIn() && data.ownerId == request.auth.uid; }

    match /users/{userId} {
      allow read, write: if ownUser(userId);
      match /workspace/{document} {
        allow read, delete: if ownUser(userId);
        allow create, update: if ownUser(userId)
          && request.resource.data.keys().hasOnly(['revision', 'chunkCount', 'updatedAt'])
          && request.resource.data.revision is string
          && request.resource.data.chunkCount is int
          && request.resource.data.chunkCount > 0 && request.resource.data.chunkCount <= 200;
      }
      match /revisions/{revision}/chunks/{chunkId} {
        allow read, delete: if ownUser(userId);
        allow create: if ownUser(userId)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string;
      }
    }

    function share(slug) {
      return get(/databases/$(database)/documents/sharedLogs/$(slug)).data;
    }
    function canReadShare(slug, revision) {
      let data = share(slug);
      return data.revision != 'revoked' && data.revision == revision && (
        owner(data)
        || (signedIn() && (
          exists(/databases/$(database)/documents/sharedLogs/$(slug)/members/$(request.auth.uid))
            ? get(/databases/$(database)/documents/sharedLogs/$(slug)/members/$(request.auth.uid)).data.linked == true
            : request.auth.uid in data.memberIds))
        || (data.scope == 'public' && data.scenarioPolicy == 'public')
        || (signedIn() && data.scope == 'passed' && data.scenarioPolicy == 'public'
          && exists(/databases/$(database)/documents/sharedLogs/$(slug)/access/$(request.auth.uid)))
      );
    }
    function validMember() {
      let data = request.resource.data;
      return data.keys().hasOnly(['inviteId', 'hidden', 'linked', 'displayName', 'color', 'image'])
        && data.inviteId is string && data.hidden is bool && data.linked is bool
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.color is string && data.color.matches('^#[0-9a-fA-F]{6}$')
        && data.image is string && data.image.size() <= 4096;
    }
    function validShare() {
      let data = request.resource.data;
      return data.keys().hasOnly(['ownerId', 'scope', 'memberIds', 'scenarioPolicy', 'revision', 'chunkCount'])
        && data.ownerId == request.auth.uid
        && data.scope in ['members', 'passed', 'public']
        && data.scenarioPolicy in ['unknown', 'members', 'public']
        && (data.scope == 'members' || data.scenarioPolicy == 'public')
        && data.memberIds is list && data.memberIds.size() <= 500
        && data.revision is string
        && data.chunkCount is int && data.chunkCount > 0 && data.chunkCount <= 200;
    }

    match /sharedLogs/{slug} {
      // Only access metadata: no title, names, log text or profile data.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && validShare();
      allow update: if owner(resource.data) && validShare();
      allow delete: if false;

      match /revisions/{revision}/chunks/{chunkId} {
        allow read: if owner(resource.data) || canReadShare(slug, revision);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['data', 'ownerId'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.data is string
          && (!exists(/databases/$(database)/documents/sharedLogs/$(slug)) || owner(share(slug)));
        allow delete: if owner(resource.data);
      }
      match /access/{userId} {
        allow get, delete: if ownUser(userId);
        allow create, update: if ownUser(userId)
          && share(slug).scope == 'passed' && share(slug).scenarioPolicy == 'public'
          && request.resource.data.keys().hasOnly(['passed'])
          && request.resource.data.passed == true;
      }
      match /members/{userId} {
        allow get, list: if ownUser(userId) || owner(share(slug))
          || (resource.data.hidden == false && resource.data.linked == true && canReadShare(slug, share(slug).revision));
        allow create: if ownUser(userId) && validMember() && (
          owner(share(slug)) || userId in share(slug).memberIds || (
            request.resource.data.hidden == false && request.resource.data.linked == true
            && get(/databases/$(database)/documents/sharedInvites/$(request.resource.data.inviteId)).data.slug == slug
            && get(/databases/$(database)/documents/sharedInvites/$(request.resource.data.inviteId)).data.ownerId == share(slug).ownerId
            && get(/databases/$(database)/documents/sharedInvites/$(request.resource.data.inviteId)).data.expiresAt > request.time));
        allow update: if (
          ownUser(userId) && validMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'linked', 'displayName', 'color', 'image']))
          || (owner(share(slug)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linked'])
            && request.resource.data.linked == false);
        allow delete: if false;
      }
    }
    match /sharedInvites/{token} {
      allow get: if resource.data.expiresAt > request.time
        && exists(/databases/$(database)/documents/sharedLogs/$(resource.data.slug))
        && share(resource.data.slug).revision != 'revoked';
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['slug', 'ownerId', 'title', 'systemId', 'scenarioTitle', 'expiresAt'])
        && request.resource.data.ownerId == request.auth.uid
        && owner(share(request.resource.data.slug))
        && token.size() >= 32
        && request.resource.data.title is string && request.resource.data.systemId is string
        && request.resource.data.scenarioTitle is string
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');
      allow delete: if owner(resource.data);
    }
    // カレンダー購読: 推測できないトークン名の文書を、リンクを知る人だけが 1 件ずつ読める（一覧は不可）
    match /calendarFeeds/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && token.size() >= 32
        && request.resource.data.keys().hasOnly(['ownerId', 'ics', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ics is string && request.resource.data.ics.size() <= 900000
        && request.resource.data.updatedAt is timestamp;
      allow update: if owner(resource.data)
        && request.resource.data.keys().hasOnly(['ownerId', 'ics', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.ics is string && request.resource.data.ics.size() <= 900000
        && request.resource.data.updatedAt is timestamp;
      allow delete: if owner(resource.data);
    }
    match /sharedCharacters/{characterId} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if signedIn()
        && (!exists(/databases/$(database)/documents/sharedCharacters/$(characterId)) || owner(resource.data))
        && request.resource.data.keys().hasOnly(['ownerId', 'enabled', 'revision', 'chunkCount'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.enabled is bool
        && request.resource.data.revision is string
        && request.resource.data.chunkCount is int && request.resource.data.chunkCount > 0 && request.resource.data.chunkCount <= 200;
      match /revisions/{revision}/chunks/{chunkId} {
        allow read: if owner(resource.data) || (
          get(/databases/$(database)/documents/sharedCharacters/$(characterId)).data.enabled == true
          && get(/databases/$(database)/documents/sharedCharacters/$(characterId)).data.revision == revision);
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['data', 'ownerId'])
          && request.resource.data.ownerId == request.auth.uid && request.resource.data.data is string
          && (!exists(/databases/$(database)/documents/sharedCharacters/$(characterId))
            || owner(get(/databases/$(database)/documents/sharedCharacters/$(characterId)).data));
        allow delete: if owner(resource.data);
      }
    }
  }
}
