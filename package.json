{
  "name": "takufu",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "next build && node scripts/ops.ts standalone",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts e2e mobile/src mobile/app.config.ts && oxfmt --check src scripts e2e mobile/src mobile/app.config.ts && node scripts/lint-design.ts",
    "fmt": "oxfmt src scripts e2e mobile/src mobile/app.config.ts",
    "gen:data": "node scripts/gen-data.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "review": "node scripts/ops.ts review",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run mobile:typecheck && pnpm run test && NEXT_SKIP_TYPECHECK=1 pnpm run build",
    "test:mutation": "stryker run",
    "mobile:device": "node scripts/mobile-device.ts",
    "mobile:start": "pnpm --dir mobile run start",
    "mobile:ios": "pnpm --dir mobile run ios",
    "mobile:android": "pnpm --dir mobile run android",
    "mobile:typecheck": "pnpm --dir mobile run typecheck",
    "mobile:export": "pnpm --dir mobile run export:check",
    "deploy:rules": "node scripts/ops.ts rules",
    "check:emulator": "node scripts/emulator-smoke.ts",
    "deploy": "node scripts/ops.ts deploy",
    "check:firebase": "node scripts/ops.ts firebase",
    "start": "next start -p 5173",
    "fonts:lp": "node scripts/subset-lp-fonts.ts",
    "gen:icons": "node scripts/gen-icons.ts && oxfmt src/components/icons.tsx mobile/src/components/icons.tsx"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "firebase": "^13.4.0",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@iconify-json/logos": "^1.2.1",
    "@iconify-json/simple-icons": "^1.2.4",
    "@iconify-json/tabler": "^1.2.10",
    "@playwright/test": "^1.65.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "daisyui": "^4.12.24",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
